# Copy only locally; never commit real values. Flask CLI may load .env automatically.
# Required Vercel server secrets (use the transaction pooler, port 6543).
DATABASE_URL=postgresql://huddle_backend.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-vercel-only
SUPABASE_STORAGE_BUCKET=huddle-assets
HUDDLE_ENCRYPTION_KEY=replace-with-base64url-encoded-random-32-bytes
PUBLIC_BASE_URL=https://YOUR_PROJECT.vercel.app

# Optional: configure only after adding custom domains to the SAME Vercel project.
# HUDDLE_PUBLIC_ORIGIN=https://huddle.co.in
# HUDDLE_APP_ORIGIN=https://app.huddle.co.in
# HUDDLE_APP_HOST=app.huddle.co.in
# HUDDLE_CARD_HOST=c.huddle.co.in
# HUDDLE_CARD_ORIGIN=https://c.huddle.co.in

# Optional outgoing invitations. Use a verified Resend sender.
# RESEND_API_KEY=
# RESEND_FROM=HUDDLE <cards@your-verified-domain.com>
# Optional Google sign-in: configure exact callback /api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LOCAL MIGRATION MACHINE ONLY; do NOT add the admin connection URL to Vercel.
# Copy admin session-pooler URL from Supabase Connect (port 5432).
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Optional billing. Keep all secrets server-side; start in TEST mode.
# Different test/live webhook secrets and plan IDs are required.
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PRO_MONTHLY=plan_...
# RAZORPAY_PLAN_PRO_ANNUAL=plan_...
# RAZORPAY_PLAN_ENTERPRISE_MONTHLY=plan_...
# Webhook URL: https://YOUR_PROJECT.vercel.app/api/webhooks/razorpay
